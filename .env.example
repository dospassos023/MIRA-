# Inject through your shell or local secret manager. Uvicorn does not load this file.
# Generate separate values with: python -c "import secrets; print(secrets.token_hex(32))"
MIRA_OWNER_TOKEN=
# Leave MIRA_LINDA_TOKEN unset to disable Linda access.
MIRA_DB_PATH=data/mira.sqlite3
MIRA_PROVIDER=none
# MIRA_PROVIDER=ollama
# MIRA_MODEL=<locally installed model name>
# MIRA_OLLAMA_URL=http://127.0.0.1:11434
# MIRA_PROVIDER=openai
# MIRA_MODEL=<API model ID>
# OPENAI_API_KEY=<inject as a secret>
